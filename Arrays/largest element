#include <bits/stdc++.h> 
int largestElement(vector<int> &arr, int n) {
   int largest =arr[0];
   for(int i=1;i<arr.size();i++){
       if (arr[i]>largest){
           largest=arr[i];
       }
   }
   return largest;
}
