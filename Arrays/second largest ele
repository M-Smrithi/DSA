#include <bits/stdc++.h> 
int findSecondLargest(int n, vector<int> &arr)
{ 
int largest=arr[0]; //find largest
for (int i=1;i<n;i++){
    if(arr[i]>largest)
    largest=arr[i];
}

int second=INT_MIN;
for(int i=0;i<n;i++){
    if (arr[i]<largest & arr[i]!=largest & arr[i]>second)
        second=arr[i];
}

 return second==INT_MIN?-1:second;
}
